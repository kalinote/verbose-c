#include "../practical_console.inc"

// 排序和统计通过数组参数共享调用方的数据。
void swap(int values[], int left, int right) {
    int saved = values[left];
    values[left] = values[right];
    values[right] = saved;
}

void sort(int values[], int count) {
    for (int end = count - 1; end > 0; end--) {
        for (int i = 0; i < end; i++) {
            if (values[i] > values[i + 1]) { swap(values, i, i + 1); }
        }
    }
}

int sum(int values[], int count) {
    int total = 0;
    for (int i = 0; i < count; i++) { total += values[i]; }
    return total;
}

int main() {
    int values[5] = {9, 1, 5, 3, 2};
    sort(values, 5);
    write(STDOUT, "排序结果：");
    for (int i = 0; i < 5; i++) {
        if (i > 0) { write(STDOUT, " "); }
        print_integer(values[i]);
    }
    write(STDOUT, "\n合计：");
    print_integer(sum(values, 5));
    write(STDOUT, "\n");
    return 0;
}
