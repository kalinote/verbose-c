%% Verbose-C 当前模块关系，核对日期：2026-09-21。
%% 本图表示模块职责和数据依赖；执行顺序见 PROGRAM_EXECUTION_FLOW.mmd。
%% 编译和 VM 循环细节见 COMPILATION_FLOW.mmd、VM_EXECUTION_FLOW.mmd。
%% 实线为主要数据/调用关系，虚线为元数据、诊断或按需补全。
%% 原生后端支持 Windows x64 稳定子集；O2/O3 与热点 JIT 尚未实现。
flowchart TB
    subgraph inputs["输入与命令行"]
        source[".vbc 入口源码"]
        includeFiles["生效分支中的 include 文件"]
        bytecodeFile[".vbb 字节码文件"]
        grammarFile["Grammar/verbose_c.gram"]
        cli["cli.py：参数、互斥检查与模式分派"]
    end

    subgraph engine["编译与执行编排：verbose_c/engine"]
        pipeline["run_source_file / run_bytecode_file → _run_file_pipeline"]
        compileModule["compile_module：组织前端与后端阶段"]
        compilerOutput["CompilerOutput：字节码、元数据和可用后端结果"]
        runResult["RunResult：success、exit_code、错误与产物路径"]
    end

    subgraph filesystem["文件与缓存：verbose_c/fs"]
        sourceManager["SourceManager：路径、源码缓存、include 解析"]
        incremental["IncrementalCompiler：源码/依赖摘要与缓存修订检查"]
        artifactStore["ArtifactStore：VBB version 2 读写和完整性校验"]
        manifest[".vbb.deps.json：入口翻译单元依赖清单"]
    end

    subgraph frontend["解析器生成与源码前端"]
        ppg["parser/ppg：解析语法、校验并生成 Python 解析器"]
        parserFile["parser.py：生成的语言解析器"]
        lexer["Lexer / Tokenizer：原始 Token、位置与回溯"]
        preprocessor["Preprocessor：Token 宏展开、include、条件块"]
        parser["GeneratedParser.start：Token → AST"]
    end

    subgraph compiler["语义与字节码：verbose_c/compiler"]
        typeChecker["TypeChecker：类型、作用域与诊断"]
        symbols["类型与符号：数组、指针、结构体、类、函数"]
        astOptimizer["ast_optimizer.py：可选 typed AST O1"]
        opcodeGenerator["OpcodeGenerator：字节码、常量池、标签与行号"]
        bytecodeOptimizer["bytecode_optimizer.py：标签解析后可选 O1"]
    end

    subgraph native["原生编译：compiler/ir 与 compiler/native"]
        ir["字节码 → IR / CFG：lowering、validator、formatter"]
        machine["IR → Machine IR：Windows x64 ABI、栈槽与数组引用"]
        codegen["codegen / encoder：x64 机器码与修补"]
        nativeModel["model / listing_formatter / map_format：模型与导出元数据"]
        runtime["runtime / runtime_image：字符串、标准 I/O、错误与退出"]
        peWriter["pe_writer / pe_layout / relocations：PE 与基址重定位"]
        runner["runner：Windows x64 内存执行"]
        exporter["NativeArtifactExporter：导出、读回、自检与 manifest"]
        nativeFiles["独立 EXE / listing / bin / map / bundle"]
    end

    subgraph vm["解释执行：verbose_c/vm 与 verbose_c/object"]
        virtualMachine["VBCVirtualMachine.excute：取指、分发、调用与返回"]
        objects["VBCObject 类型：标量、函数、类、实例、结构体与指针"]
        memory["MemoryManager：变量、数组与结构体的模拟地址槽"]
        gc["GarbageCollector：受管理对象按分配阈值标记清扫"]
        builtins["builtins_functions：文件 I/O、标准流与 exit"]
        systemRuntime["SystemRuntime：CRT/libc 与 Windows 控制台适配"]
    end

    subgraph reporting["诊断与过程报告"]
        diagnostics["error：结构化报告、源码上下文和调用栈格式化"]
        recorder["PipelineRecorder：按需日志与 dumps 报告"]
    end

    source --> cli
    bytecodeFile --> cli
    cli --> pipeline
    cli -->|"--compile-parser"| ppg
    grammarFile --> ppg --> parserFile
    pipeline --> incremental
    incremental --> manifest
    incremental -->|"检查产物存在性"| artifactStore
    pipeline -->|"缓存命中 / .vbb 输入"| artifactStore
    artifactStore --> compilerOutput
    pipeline -->|"需要源码编译"| compileModule
    compileModule --> sourceManager --> lexer --> preprocessor --> parser
    source --> sourceManager
    includeFiles --> sourceManager
    parserFile --> parser
    compileModule -.->|"缺失或 -rp 时生成"| ppg
    preprocessor -.->|"实际依赖"| manifest
    preprocessor -->|"读取 include"| sourceManager
    parser --> typeChecker
    typeChecker <--> symbols
    typeChecker --> astOptimizer --> opcodeGenerator --> bytecodeOptimizer
    symbols --> opcodeGenerator
    bytecodeOptimizer --> compilerOutput
    compilerOutput -->|"新编译后保存"| artifactStore
    compilerOutput -.->|"新编译尝试；加载后按需补全"| ir
    ir --> machine --> codegen --> nativeModel
    codegen --> runtime
    nativeModel --> runner
    nativeModel --> exporter
    nativeModel --> peWriter
    runtime --> peWriter
    peWriter --> exporter --> nativeFiles
    nativeFiles -->|"调试 PE 由系统 loader 执行"| runResult
    runner --> runResult
    compilerOutput -->|"需要 VM 执行"| virtualMachine
    virtualMachine --> objects
    virtualMachine --> memory
    virtualMachine --> gc
    virtualMachine --> builtins --> systemRuntime
    virtualMachine --> runResult
    pipeline -->|"编译/导出结果"| runResult
    pipeline -.-> diagnostics
    diagnostics -.->|"相同诊断正文"| recorder
    compileModule -.-> recorder
    virtualMachine -.-> recorder
    exporter -.-> recorder

    classDef control fill:#E8F1FF,stroke:#4A78B8
    classDef backend fill:#EEE8FA,stroke:#8567AB
    classDef execution fill:#E6F4EA,stroke:#45835A
    classDef diagnostic fill:#FCE8E6,stroke:#B6534B
    class cli,pipeline,compileModule,compilerOutput,runResult control
    class ir,machine,codegen,nativeModel,runtime,peWriter,exporter backend
    class virtualMachine,runner,memory,gc,builtins,systemRuntime execution
    class diagnostics,recorder diagnostic
